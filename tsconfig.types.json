  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "declaration": true,
    "inlineSourceMap": true,
    "emitDeclarationOnly": true
  },
  "exclude": ["samples/", "**/*.spec.ts"]
}
